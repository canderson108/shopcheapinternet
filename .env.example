# ---------------------------------------------------------------------------
# Shop Cheap Internet — environment variables
# Copy to .env for local development. In Vercel, set these under
# Project → Settings → Environment Variables. Generate secrets with: npm run gen-keys
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Pooled connection string used by the app (e.g. Neon "pooled", Supabase "transaction" pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shopcheapinternet?sslmode=require"
# Direct (non-pooled) connection used by migrations. Use the same value as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/shopcheapinternet?sslmode=require"

# Public base URL, no trailing slash. Used in emails and links.
APP_URL="https://shopcheapinternet.com"

# 32 random bytes, base64. Encrypts customer PII at rest. BACK THIS UP — data can't be decrypted without it.
DATA_ENCRYPTION_KEY=""
# Optional: previous key during key rotation.
DATA_ENCRYPTION_KEY_PREVIOUS=""
# Random secret for keyed lookup hashes (email/phone search, IP hashing). Never change after launch.
HASH_PEPPER=""

# --- Staff security ---------------------------------------------------------
# Two-factor authentication for staff. Keep "true" in production.
STAFF_MFA_REQUIRED="true"
# One-time token for /setup (creates the first admin). Remove after use.
SETUP_TOKEN=""

# --- Vercel Cron --------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/maintenance.
CRON_SECRET=""

# --- Provider portal ----------------------------------------------------------
# Default AT&T SPOC entry URL used when seeding the AT&T provider. Use your authorized sign-in
# landing URL — NOT a URL containing a (S(...)) session id. Editable later in Admin → Providers.
ATT_SPOC_PORTAL_URL="https://www.attspoc.com/"

# --- Transactional email ------------------------------------------------------
# resend | postmark | smtp | log  ("log" prints emails to the server log — development only)
EMAIL_PROVIDER="log"
EMAIL_FROM="Shop Cheap Internet <enroll@shopcheapinternet.com>"
EMAIL_REPLY_TO="support@shopcheapinternet.com"
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=""
# Team inbox notified when an enrollment waits in the queue with no agent available.
AGENT_NOTIFY_EMAIL=""

# --- Address verification (Smarty: US Autocomplete Pro + US Street API) -------
# Secret keys (server-side only). Without them, addresses are accepted unverified and agents verify.
SMARTY_AUTH_ID=""
SMARTY_AUTH_TOKEN=""

# --- Analytics & ads (all optional) -------------------------------------------
NEXT_PUBLIC_GA4_ID=""
# GA4 Measurement Protocol secret — enables server-side "order_confirmed"/"purchase" events.
GA4_API_SECRET=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Public contact info ------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL="support@shopcheapinternet.com"
NEXT_PUBLIC_SUPPORT_PHONE=""

# --- Data retention -----------------------------------------------------------
# Days after an order closes before customer PII is erased automatically. 0 = disabled.
DATA_RETENTION_DAYS="0"
