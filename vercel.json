{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "crons": [
    { "path": "/api/cron/maintenance", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "src/app/api/**/events/route.ts": { "maxDuration": 60 }
  }
}
